# Copy to .env to override defaults. Everything works with NO .env at all.
# Nothing here is a cloud service — Neo4j and Ollama are both local.

ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# --- Neo4j (local) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mainframe
NEO4J_DATABASE=neo4j

# --- LLM (local-first) ---
# provider: ollama | heuristic   (no cloud provider by design)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# Default model: qwen2.5:7b-instruct — Apache-2.0, fully open source (~4.7 GB).
#   ollama pull qwen2.5:7b-instruct
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_S=120
