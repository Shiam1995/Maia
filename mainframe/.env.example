# --- App ---
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# Async URL (asyncpg). Alembic derives the sync URL automatically.
DATABASE_URL=postgresql+asyncpg://mainframe:mainframe@localhost:5432/mainframe

# --- File storage ---
UPLOAD_DIR=uploads
MEDIA_URL_PREFIX=/media

# --- LLM layer (natural-language meal parsing) ---
# claude | ollama | heuristic. Falls back to heuristic if the provider is
# unavailable (e.g. no API key), so the app always works.
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
# For local Ollama (LLM_PROVIDER=ollama):
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Nutrient lookup ---
# DEMO_KEY works but is rate limited. Free key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=DEMO_KEY
NUTRIENT_SOURCES=usda,openfoodfacts
